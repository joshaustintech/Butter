{
  "name": "Cottage Butter",
  "version": "1.0.0",
  "platform": "iOS 26+, SwiftUI",
  "color": {
    "background":      { "light": "#FFFBEF", "dark": "#1F1A12", "swift": "Color.butterBackground",      "asset": "ButterBackground" },
    "surface":         { "light": "#FFF6C7", "dark": "#2A2319", "swift": "Color.butterSurface",        "asset": "ButterSurface" },
    "separator":       { "light": "#EBDDB8", "dark": "#3F3626", "swift": "Color.butterSeparator",      "asset": "ButterSeparator" },
    "primary":         { "light": "#FBE27A", "dark": "#F3D978", "swift": "Color.butterPrimary",        "asset": "ButterPrimary", "use": "Fills only. Never text." },
    "onPrimary":       { "light": "#3B2F1E", "dark": "#2A2010", "swift": "Color.butterOnPrimary",      "asset": "ButterOnPrimary", "use": "Text and icons on primary." },
    "label":           { "light": "#3B2F1E", "dark": "#FBF3DC", "swift": "Color.butterLabel",          "asset": "ButterLabel" },
    "labelSecondary":  { "light": "#6B5B45", "dark": "#C9B99A", "swift": "Color.butterLabelSecondary", "asset": "ButterLabelSecondary" },
    "accent":          { "light": "#5E7254", "dark": "#A9C29A", "swift": "Color.butterAccent",         "asset": "ButterAccent", "use": "App tint, links, secondary buttons." },
    "sageFill":        { "light": "#EAF0E2", "dark": "#2E3927", "swift": "Color.butterSageFill",       "asset": "ButterSageFill" },
    "blushFill":       { "light": "#F8E1DE", "dark": "#3A2725", "swift": "Color.butterBlushFill",      "asset": "ButterBlushFill" },
    "blushAccent":     { "light": "#F2C4C0", "dark": "#E8B1AC", "swift": "Color.butterBlushAccent",    "asset": "ButterBlushAccent", "use": "Decoration only, never text." },
    "error":           { "light": "#A8443C", "dark": "#F0A59C", "swift": "Color.butterError",          "asset": "ButterError" }
  },
  "spacing": { "xxs": 4, "xs": 8, "sm": 12, "md": 16, "lg": 20, "xl": 24, "xxl": 32, "xxxl": 40, "swift": "ButterSpacing" },
  "radius":  { "small": 12, "medium": 16, "large": 24, "pill": "Capsule", "swift": "ButterRadius", "style": "continuous" },
  "typography": {
    "text":    { "font": "SF Pro (system)", "rule": "Use Dynamic Type text styles (.body, .headline, ...). No fixed point sizes." },
    "display": { "font": "New York (system serif)", "swift": "Font.butterDisplay(_:)", "rule": "Titles, greetings, empty states. Max two per screen." }
  },
  "sizing": { "minTouchTarget": 44, "primaryButtonMinHeight": 50 },
  "contrast": { "text": "4.5:1 minimum", "largeText": "3:1 minimum" },
  "rules": [
    "Colors come from the asset catalog (Color.butter*), never hard-coded hex.",
    "Yellow never carries text or error states.",
    "Use SF Symbols via Image(systemName:) for icons.",
    "Use RoundedRectangle(cornerRadius:style: .continuous) or Capsule for shapes.",
    "Every token has a dark pair; dark mode is automatic through the asset catalog."
  ]
}
